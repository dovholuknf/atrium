# Keep source files as LF on every platform. Windows checkouts with
# core.autocrlf=true otherwise make gofmt report every Go file as changed.
# Use explicit extensions so files such as toasts.js can opt out below.

*.go    text eol=lf
*.sh    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# Use CRLF for Windows PowerShell scripts.
*.ps1   text eol=crlf

# toasts.js contains two NUL bytes (B2-51), so git treats it as binary.
# Leave its line endings alone until those bytes are cleaned up.
internal/api/web/js/toasts.js -text

*.png   binary
*.ico   binary
*.zip   binary
*.exe   binary
